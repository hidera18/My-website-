<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>منتقي الألوان - الأدوات الذكية</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="../style.css">
    <style>
        .tool-container {
            background: var(--card-bg, #ffffff);
            padding: 35px 25px;
            border-radius: 16px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.05);
            max-width: 500px;
            margin: 0 auto 50px auto;
            text-align: center;
        }
        .back-btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: var(--text-light, #64748b);
            text-decoration: none;
            font-weight: bold;
            margin-bottom: 20px;
        }
        input[type="color"] {
            width: 120px;
            height: 120px;
            border: none;
            border-radius: 50%;
            cursor: pointer;
            margin-bottom: 25px;
            background: none;
        }
        .code-box {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: #f8fafc;
            padding: 12px 18px;
            border-radius: 10px;
            margin-bottom: 12px;
            border: 1px solid #e2e8f0;
            font-weight: bold;
        }
        .btn-sm {
            background: var(--primary-color, #2563eb);
            color: white;
            border: none;
            padding: 6px 14px;
            border-radius: 6px;
            cursor: pointer;
            font-family: inherit;
        }
    </style>
</head>
<body>
    <header class="main-header" style="padding: 30px 20px; margin-bottom: 30px; border-radius: 0 0 25px 25px;">
        <h1>🎨 منتقي الألوان</h1>
        <p>اختر أي لون واستخرج كود الـ HEX و RGB بسهولة</p>
    </header>

    <main class="container">
        <a href="../index.html" class="back-btn">&rarr; العودة إلى القائمة الرئيسية</a>

        <div class="tool-container">
            <input type="color" id="color-picker" value="#2563eb">

            <div class="code-box">
                <span>HEX: <span id="hex-val">#2563eb</span></span>
                <button class="btn-sm" onclick="copyVal('hex-val')">نسخ</button>
            </div>

            <div class="code-box">
                <span>RGB: <span id="rgb-val">rgb(37, 99, 235)</span></span>
                <button class="btn-sm" onclick="copyVal('rgb-val')">نسخ</button>
            </div>
        </div>
    </main>

    <script src="../script.js" defer></script>
    <script>
        const picker = document.getElementById('color-picker');
        const hexVal = document.getElementById('hex-val');
        const rgbVal = document.getElementById('rgb-val');

        picker.addEventListener('input', (e) => {
            const hex = e.target.value;
            hexVal.textContent = hex;
            
            // تحويل إلى RGB
            const r = parseInt(hex.slice(1, 3), 16);
            const g = parseInt(hex.slice(3, 5), 16);
            const b = parseInt(hex.slice(5, 7), 16);
            rgbVal.textContent = `rgb(${r}, ${g}, ${b})`;
        });

        function copyVal(id) {
            const text = document.getElementById(id).textContent;
            if (typeof copyToClipboard === 'function') {
                copyToClipboard(text);
            } else {
                navigator.clipboard.writeText(text);
                alert("تم النسخ!");
            }
        }
    </script>
</body>
</html>
