<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>محول صيغ الصور - الأدوات الذكية</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="../style.css">
    <style>
        .tool-container { background: var(--card-bg, #ffffff); padding: 35px 25px; border-radius: 16px; box-shadow: 0 10px 25px rgba(0,0,0,0.05); max-width: 600px; margin: 0 auto 50px auto; text-align: center; }
        .back-btn { display: inline-flex; align-items: center; gap: 8px; color: var(--text-light, #64748b); text-decoration: none; font-weight: bold; margin-bottom: 20px; }
        input[type="file"] { margin-bottom: 20px; width: 100%; border: 2px solid #e2e8f0; padding: 10px; border-radius: 8px; }
        select { width: 100%; padding: 12px; margin-bottom: 20px; border-radius: 8px; font-family: inherit; font-size: 1.1rem; border: 2px solid #cbd5e1; }
        .btn { background: var(--primary-color, #2563eb); color: white; border: none; padding: 12px 24px; border-radius: 8px; cursor: pointer; font-weight: bold; font-family: inherit; width: 100%; }
        .btn:hover { background: var(--secondary-color, #1e40af); }
    </style>
</head>
<body>
    <header class="main-header" style="padding: 30px 20px; margin-bottom: 30px; border-radius: 0 0 25px 25px;">
        <h1>🔄 محول صيغ الصور</h1>
        <p>حول صورك إلى صيغ مختلفة (JPG, PNG, WEBP) بكل سهولة</p>
    </header>

    <main class="container">
        <a href="../index.html" class="back-btn">&rarr; العودة إلى القائمة الرئيسية</a>
        <div class="tool-container">
            <input type="file" id="file-input" accept="image/*">
            <select id="format-select">
                <option value="image/png">تحويل إلى PNG</option>
                <option value="image/jpeg">تحويل إلى JPG</option>
                <option value="image/webp">تحويل إلى WEBP</option>
            </select>
            <button class="btn" id="convert-btn">تحويل وتحميل الصورة 🚀</button>
        </div>
    </main>

    <script src="../script.js" defer></script>
    <script>
        document.getElementById('convert-btn').addEventListener('click', () => {
            const fileInput = document.getElementById('file-input');
            const format = document.getElementById('format-select').value;
            
            if (fileInput.files.length === 0) {
                if (typeof showNotification === 'function') showNotification("يرجى اختيار صورة أولاً ⚠️", true);
                return;
            }

            const file = fileInput.files[0];
            const reader = new FileReader();
            
            reader.onload = (e) => {
                const img = new Image();
                img.onload = () => {
                    const canvas = document.createElement('canvas');
                    canvas.width = img.width;
                    canvas.height = img.height;
                    const ctx = canvas.getContext('2d');
                    ctx.drawImage(img, 0, 0);
                    
                    const dataUrl = canvas.toDataURL(format);
                    const ext = format.split('/')[1];
                    
                    const link = document.createElement('a');
                    link.href = dataUrl;
                    link.download = `converted-image.${ext}`;
                    link.click();
                    
                    if (typeof showNotification === 'function') showNotification("تم التحويل والتحميل بنجاح! 🎉");
                };
                img.src = e.target.result;
            };
            reader.readAsDataURL(file);
        });
    </script>
</body>
</html>
